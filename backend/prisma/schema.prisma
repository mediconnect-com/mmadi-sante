// Schéma Prisma de MmadiSanté (PostgreSQL).
//
// IMPORTANT (Supabase / pooler) :
//   - DATABASE_URL = chaîne du pooler, port 6543, avec ?pgbouncer=true  -> utilisée à l'EXÉCUTION de l'API
//   - DIRECT_URL   = connexion directe (ou "Session pooler"), port 5432 -> utilisée pour les MIGRATIONS
// En local (PostgreSQL classique), les deux variables peuvent être identiques.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Profils utilisateurs
enum Role {
  PATIENT
  MEDECIN
  ADMIN
}

/// Catégories de documents médicaux
enum CategorieDocument {
  ORDONNANCE
  DIAGNOSTIC
  ANALYSE
  COMPTE_RENDU
  AUTRE
}

/// Type de professionnel rattaché à une spécialité (permet de distinguer médecins et autres professionnels de santé).
enum TypeProfessionnel {
  MEDECIN
  PROFESSIONNEL_SANTE
}

/// Cycle de vie d'un rendez-vous.
enum StatutRendezVous {
  DEMANDE
  CONFIRME
  REFUSE
  ANNULE
}

/// Un compte utilisateur (patient, médecin ou administrateur) et ses informations personnelles.
/// Une « fiche médecin sans compte » (sansCompte = true) n'a pas d'accès à l'application : e-mail facultatif.
model Utilisateur {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String?  @unique
  motDePasseHash        String   @map("mot_de_passe_hash")
  role                  Role     @default(PATIENT)
  nom                   String
  prenom                String
  adresse               String?
  telephone             String?
  /// Adresse du cabinet / lieu d'exercice (fiche médecin).
  adresseProfessionnelle String? @map("adresse_professionnelle")
  /// true = fiche créée sans compte de connexion (par un patient ou un administrateur).
  sansCompte            Boolean  @default(false) @map("sans_compte")
  /// Numéro de pièce d'identité, chiffré (AES-256-GCM) par l'API avant enregistrement.
  carteIdentiteChiffree String?  @map("carte_identite_chiffree")
  creeLe                DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifieLe             DateTime @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(6)

  documents    Document[]
  commePatient Attribution[] @relation("AttributionPatient")
  commeMedecin Attribution[] @relation("AttributionMedecin")
  specialites  MedecinSpecialite[]
  rdvCommePatient RendezVous[] @relation("RdvPatient")
  rdvCommeMedecin RendezVous[] @relation("RdvMedecin")
  documentsDeposes   Document[]           @relation("DocumentDeposePar")
  commentairesRecus  CommentairePatient[] @relation("CommentairePatient")
  commentairesRediges CommentairePatient[] @relation("CommentaireMedecin")

  @@index([role])
  @@map("utilisateurs")
}

/// Un document (ordonnance, diagnostic, ...) stocké directement dans la base.
model Document {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proprietaireId String            @map("proprietaire_id") @db.Uuid
  nomFichier     String            @map("nom_fichier")
  typeMime       String            @map("type_mime")
  tailleOctets   Int               @map("taille_octets")
  categorie      CategorieDocument @default(AUTRE)
  description    String?
  /// Contenu binaire du fichier (bytea).
  contenu        Bytes
  creeLe         DateTime          @default(now()) @map("cree_le") @db.Timestamptz(6)
  /// Médecin qui a déposé le document dans la fiche du patient (null = déposé par le patient lui-même).
  deposeParMedecinId String?       @map("depose_par_medecin_id") @db.Uuid
  /// Nom du médecin au moment du dépôt (reste lisible même si sa fiche est supprimée ensuite).
  deposeParNom   String?           @map("depose_par_nom")

  proprietaire     Utilisateur  @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)
  deposeParMedecin Utilisateur? @relation("DocumentDeposePar", fields: [deposeParMedecinId], references: [id], onDelete: SetNull)

  @@index([proprietaireId])
  @@index([deposeParMedecinId])
  @@index([proprietaireId, creeLe])
  @@map("documents")
}

/// Attribution d'un patient à un médecin (un patient peut avoir plusieurs médecins).
model Attribution {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  medecinId String   @map("medecin_id") @db.Uuid
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  patient Utilisateur @relation("AttributionPatient", fields: [patientId], references: [id], onDelete: Cascade)
  medecin Utilisateur @relation("AttributionMedecin", fields: [medecinId], references: [id], onDelete: Cascade)

  @@unique([patientId, medecinId])
  @@index([medecinId])
  @@map("attributions")
}

/// Une spécialité médicale (ou profession de santé) de la liste prédéfinie, modifiable par l'administrateur.
/// Une spécialité n'est jamais supprimée : on la désactive (actif = false) pour conserver l'historique.
model Specialite {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libelle   String            @unique
  groupe    String
  type      TypeProfessionnel @default(MEDECIN)
  actif     Boolean           @default(true)
  creeLe    DateTime          @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifieLe DateTime          @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(6)

  medecins MedecinSpecialite[]

  @@map("specialites")
}

/// Liaison médecin <-> spécialités (un médecin peut avoir plusieurs spécialités).
model MedecinSpecialite {
  medecinId    String   @map("medecin_id") @db.Uuid
  specialiteId String   @map("specialite_id") @db.Uuid
  creeLe       DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)

  medecin    Utilisateur @relation(fields: [medecinId], references: [id], onDelete: Cascade)
  specialite Specialite  @relation(fields: [specialiteId], references: [id], onDelete: Cascade)

  @@id([medecinId, specialiteId])
  @@index([specialiteId])
  @@map("medecin_specialites")
}

/// Un rendez-vous demandé par un patient auprès d'un médecin.
model RendezVous {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String           @map("patient_id") @db.Uuid
  medecinId String           @map("medecin_id") @db.Uuid
  dateHeure DateTime         @map("date_heure") @db.Timestamptz(6)
  motif     String?
  statut    StatutRendezVous @default(DEMANDE)
  creeLe    DateTime         @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifieLe DateTime         @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(6)

  patient Utilisateur @relation("RdvPatient", fields: [patientId], references: [id], onDelete: Cascade)
  medecin Utilisateur @relation("RdvMedecin", fields: [medecinId], references: [id], onDelete: Cascade)
  /// Commentaire et pathologies rédigés par le médecin à propos de ce rendez-vous (au plus un).
  commentaire CommentairePatient?

  @@index([patientId])
  @@index([medecinId, dateHeure])
  @@map("rendez_vous")
}

/// Commentaire et pathologies d'un patient, rédigés par un de ses médecins ; le patient peut les lire.
model CommentairePatient {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  /// Médecin auteur (null si sa fiche a été supprimée : son nom est conservé dans medecinNom).
  medecinId  String?  @map("medecin_id") @db.Uuid
  medecinNom String   @map("medecin_nom")
  /// Rendez-vous à propos duquel le commentaire est rédigé (un seul commentaire par rendez-vous).
  rendezVousId String? @unique @map("rendez_vous_id") @db.Uuid
  pathologies String?
  commentaire String?
  creeLe     DateTime @default(now()) @map("cree_le") @db.Timestamptz(6)
  modifieLe  DateTime @default(now()) @updatedAt @map("modifie_le") @db.Timestamptz(6)

  patient Utilisateur  @relation("CommentairePatient", fields: [patientId], references: [id], onDelete: Cascade)
  medecin Utilisateur? @relation("CommentaireMedecin", fields: [medecinId], references: [id], onDelete: SetNull)
  rendezVous RendezVous? @relation(fields: [rendezVousId], references: [id], onDelete: SetNull)

  @@index([patientId, creeLe])
  @@index([medecinId])
  @@map("commentaires_patients")
}
