# ============================================================================
#  MmadiSanté — variables d'environnement de l'API (backend)
#  Copiez ce fichier en « .env » (cp .env.example .env) puis remplissez-le.
#  Le script scripts/1-configurer.sh peut le faire à votre place, pas à pas.
#  NE PUBLIEZ JAMAIS le fichier .env (il est déjà exclu par .gitignore).
# ============================================================================

# --- Base de données PostgreSQL ---------------------------------------------
# DATABASE_URL : connexion utilisée par l'API pendant son fonctionnement (runtime).
#   * Supabase : chaîne « Transaction pooler », PORT 6543, avec ?pgbouncer=true à la fin.
#     ex. postgresql://postgres.abcdefgh:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
#   * PostgreSQL local : postgresql://mmadi:mmadi@localhost:5432/mmadisante
#   Si votre mot de passe contient des caractères spéciaux (@ : / # ? %), il doit être encodé (ex. @ -> %40).
DATABASE_URL="postgresql://mmadi:mmadi@localhost:5432/mmadisante"

# DIRECT_URL : connexion utilisée UNIQUEMENT pour les migrations Prisma (création des tables).
#   * Supabase : PORT 5432 (connexion directe db.xxxx.supabase.co, ou « Session pooler » si votre
#     réseau n'accepte pas l'IPv6). Les migrations ne fonctionnent PAS via le port 6543.
#   * PostgreSQL local : identique à DATABASE_URL.
DIRECT_URL="postgresql://mmadi:mmadi@localhost:5432/mmadisante"

# --- Sécurité ----------------------------------------------------------------
# JWT_SECRET : clé qui signe les jetons de connexion. 32 caractères minimum, secrète, unique.
#   Générer :  openssl rand -base64 48      (ou : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET="REMPLACEZ-MOI-par-une-longue-valeur-aleatoire-de-32-caracteres-minimum"

# JWT_EXPIRES_IN : durée de validité d'une connexion (ex. 8h, 30m, 1d).
JWT_EXPIRES_IN="8h"

# ENCRYPTION_KEY : clé qui chiffre le numéro de carte d'identité en base. 16 caractères minimum.
#   ⚠ Si vous la perdez ou la changez, les numéros déjà enregistrés deviennent illisibles.
#   Générer :  openssl rand -base64 32
ENCRYPTION_KEY="REMPLACEZ-MOI-par-une-autre-valeur-aleatoire-differente"

# --- Serveur -----------------------------------------------------------------
# PORT : port d'écoute de l'API (Render/Railway le fournissent eux-mêmes : ne pas le définir en ligne).
PORT=4000

# FRONTEND_URL : adresse du site web autorisé à appeler l'API (protection CORS). Plusieurs adresses
#   possibles, séparées par des virgules. Sans « / » final. OBLIGATOIRE en production.
#   Local : http://localhost:3000     —     Cloud : https://mmadi-sante-web.onrender.com
FRONTEND_URL="http://localhost:3000"

# NODE_ENV : « production » sur l'hébergeur (active les contrôles stricts). Laisser vide en local.
# NODE_ENV=production

# MAX_FILE_MB : taille maximale d'un fichier téléversé, en Mo (5 par défaut).
MAX_FILE_MB=5

# --- Options avancées --------------------------------------------------------
# SKIP_MIGRATE=true : l'API ne lance pas les migrations Prisma au démarrage (utile si vous avez créé
#   les tables vous-même avec database/schema.sql).
# SKIP_MIGRATE=true

# PRISMA_ADAPTER_PG=true : mode « sans binaire » (utilise le pilote pg au lieu du moteur natif de Prisma).
#   À activer seulement si le téléchargement des binaires Prisma est bloqué sur votre réseau
#   (nécessite aussi de générer le client avec PRISMA_CLIENT_ENGINE_TYPE=client, voir le README).
# PRISMA_ADAPTER_PG=true
