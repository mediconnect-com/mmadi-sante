# ============================================================================
#  MmadiSanté — variables d'environnement du site web (frontend)
#  En local : copiez ce fichier en « .env.local ».
#  Sur Render : variable à renseigner dans le service « mmadi-sante-web » (Environment).
# ============================================================================

# NEXT_PUBLIC_API_URL : adresse de l'API.
#
#   ⚠⚠ ELLE DOIT INCLURE LE CHEMIN COMPLET « /api/v1 » ⚠⚠
#      OK  : https://mmadi-sante-api.onrender.com/api/v1
#      NON : https://mmadi-sante-api.onrender.com        (les appels échoueraient en erreur 404)
#   (Par sécurité, le site ajoute /api/v1 tout seul s'il est absent, mais ne comptez pas dessus.)
#
#   Local : http://localhost:4000/api/v1
#
#   ⚠ Cette valeur est « figée » à la construction du site (npm run build). Après l'avoir modifiée
#      sur Render, relancez un déploiement (Manual Deploy → Deploy latest commit).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
